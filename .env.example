# Local development — copy to .env and adjust if needed
# cp .env.example .env

PORT=9092

# PostgreSQL (local install)
DATABASE_URL=jdbc:postgresql://localhost:5432/fitpro
DATABASE_USERNAME=fitpro
DATABASE_PASSWORD=fitpro

# Redis (local install)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth / CORS
JWT_SECRET=fitpro-dev-secret-change-in-production-min-256-bits-long-key!!
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SEED_ENABLED=true
